{
  "name": "study_ways",
  "version": "1.2.1",
  "babel": {
    "plugins": [
      "@babel/plugin-transform-modules-commonjs"
    ]
  },
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=8.5.5"
  },
  "dependencies": {
    "@auth0/auth0-react": "2.28.2",
    "@dagrejs/dagre": "^1.1.4",
    "@emotion/react": "^11.9.3",
    "@emotion/styled": "^11.9.3",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-tree-view": "^9.15.0",
    "@reduxjs/toolkit": "^1.8.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xyflow/react": "^12.3.1",
    "axios": "^0.27.2",
    "chart.js": "^4.5.1",
    "crypto-js": "^4.2.0",
    "file-saver": "^2.0.5",
    "js-video-url-parser": "^0.5.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-is": "18.3.1",
    "react-player": "^2.10.1",
    "react-redux": "^8.0.2",
    "react-responsive": "^9.0.0-beta.10",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "recombee-js-api-client": "^4.0.0",
    "serve": "^14.0.1",
    "typescript": "~5.9.3",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "serve -s build",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.10"
  },
  "eslintConfig": {
    "ignorePatterns": [
      "src/*",
      "!src/test.js"
    ]
  },
  "overrides": {
    "react-is": "$react-is",
    "react-scripts": {
      "typescript": "$typescript"
    }
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(?:marked|@tiptap)[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  }
}
